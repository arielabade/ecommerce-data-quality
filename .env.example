# Copie para .env (o Makefile carrega). Nenhuma credencial fica no código.
# Banco de origem: MySQL da Tecelã Tecidos, subido por ../ecommerce (docker compose).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3336
MYSQL_DATABASE=tecidos
MYSQL_USER=analista
MYSQL_PASSWORD=troque-aqui
# Alternativa: uma URL SQLAlchemy completa
# DQ_SOURCE_URL=mysql+pymysql://usuario:senha@host:3336/tecidos
# Perfil: default (banco completo) ou small (amostra versionada em data/sample)
DQ_PROFILE=default
